#!/usr/bin/env bash
# Pre-commit hook: block commits containing live secret values.
#
# Scans staged files for credential patterns (API keys, tokens, private keys).
# If any live secret is found, the commit is rejected and the offending
# file/line/pattern is printed (value redacted).
#
# Installation (from repo root):
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-commit
#
# Or copy to .git/hooks/pre-commit and chmod +x.
#
# To bypass (EMERGENCY ONLY — never use for real secrets):
#   git commit --no-verify
#
# Patterns detected match the "Secret-pattern reference" in AGENTS.md.

set -euo pipefail

# Find the repo root
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "ERROR: not in a git repository" >&2
    exit 2
}

# Use the scanner script if it exists; otherwise fall back to inline grep.
SCANNER="$REPO_ROOT/scripts/scan_secrets.py"

if [ -f "$SCANNER" ]; then
    python3 "$SCANNER" --staged-only --dry-run --audit-dir /dev/null
    exit $?
fi

# ─── Inline fallback (no scan_secrets.py available) ───────────────────────
# Grep staged files for secret patterns. This is less precise than the Python
# scanner (no placeholder filtering) but catches the common case.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

PATTERONS='sk-or-v1-[0-9A-Za-z]\{20,\}|AIza[0-9A-Za-z_-]\{35\}|glpat-[0-9A-Za-z_-]\{20\}|sk-[0-9A-Za-z]\{48\}|sk-ant-[0-9A-Za-z_-]\{40,\}|ghp_[0-9A-Za-z]\{36\}|gho_[0-9A-Za-z]\{36\}|xox[baprs]-[0-9A-Za-z-]\{10,\}|AKIA[0-9A-Z]\{16\}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

FOUND=0

for file in $STAGED_FILES; do
    # Skip binary files and common non-source suffixes
    case "$file" in
        *.pyc|*.pyo|*.so|*.o|*.png|*.jpg|*.jpeg|*.gif|*.bmp|*.ico|*.webp|\
        *.zip|*.tar|*.gz|*.bz2|*.7z|*.rar|*.pdf|*.doc|*.docx|*.xls|*.xlsx|\
        *.ppt|*.pptx|*.mp3|*.mp4|*.avi|*.mov|*.wav|*.lock|*.dvc|*.toml)
            continue
            ;;
    esac
    # Skip files in known directories
    case "$file" in
        .git/*|.venv/*|venv/*|node_modules/*|__pycache__/*|.dvc/cache/*|data/audit/*)
            continue
            ;;
    esac

    filepath="$REPO_ROOT/$file"
    [ -f "$filepath" ] || continue

    # grep for secret patterns; -n shows line number
    matches=$(grep -nE "$PATTERONS" "$filepath" 2>/dev/null || true)
    if [ -n "$matches" ]; then
        echo "ERROR: potential secret found in staged file: $file" >&2
        echo "$matches" | sed 's/\(sk-or-v1-[0-9A-Za-z]\{4\}\)[0-9A-Za-z]*/\1REDACTED/g; s/\(AIza[0-9A-Za-z_-]\{4\}\)[0-9A-Za-z_-]*/\1REDACTED/g; s/\(glpat-[0-9A-Za-z_-]\{4\}\)[0-9A-Za-z_-]*/\1REDACTED/g; s/\(sk-[0-9A-Za-z]\{4\}\)[0-9A-Za-z]*/\1REDACTED/g; s/\(ghp_[0-9A-Za-z]\{4\}\)[0-9A-Za-z]*/\1REDACTED/g; s/\(gho_[0-9A-Za-z]\{4\}\)[0-9A-Za-z]*/\1REDACTED/g; s/\(AKIA[0-9A-Z]\{4\}\)[0-9A-Z]*/\1REDACTED/g' >&2
        echo "" >&2
        FOUND=1
    fi
done

if [ "$FOUND" -ne 0 ]; then
    echo "COMMIT BLOCKED: live secret patterns detected in staged files." >&2
    echo "Remove the secrets, rotate the keys, and re-commit." >&2
    echo "If this is a false positive, use 'git commit --no-verify' (last resort)." >&2
    exit 1
fi

exit 0
