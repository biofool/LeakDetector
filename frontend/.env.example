# Frontend config — copy to .env (dev only; never commit secrets)
VITE_API_BASE_URL=http://127.0.0.1:8080

# Absolute public URL of the deployed site — used to build absolute
# og:/twitter: preview image URLs (WhatsApp etc. ignore relative og:image).
# Leave unset locally; set to the prod origin at deploy, e.g.:
# VITE_PUBLIC_URL=https://leakdetector.up.railway.app
