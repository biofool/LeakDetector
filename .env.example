# LeakDetector configuration — copy to .env.secrets (gitignored) and fill in.
# All values optional: without SMTP the app logs notifications to
# data/audit/notifications.log instead of sending email.

# Staff endpoints (PATCH /api/reports/{id}) are disabled until this is set.
STAFF_TOKEN=

# Duty-officer email notifications (new report alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DUTY_EMAIL=

# Public base URL used in notification links (e.g. https://leaks.example.nz)
BASE_URL=

# Data paths (defaults shown)
LEAK_DB_PATH=data/leakdetector.sqlite
LEAK_UPLOAD_DIR=data/uploads
LEAK_ZONES_PATH=data/council_zones.geojson
LEAK_AUDIT_DIR=data/audit
