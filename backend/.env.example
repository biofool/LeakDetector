# Backend config — copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/leakdetector
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:5173
# Public URL of THIS api — used to build absolute photo URLs (the PWA is on
# a different origin). Set to the api service's public URL on Railway.
API_PUBLIC_URL=http://127.0.0.1:8080

# Staff auth (JWT, 8 h expiry)
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=8

# Photo storage: set S3_* for a bucket (Railway disks are ephemeral).
# Without S3_*, photos go to UPLOAD_DIR on local disk (dev only).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
UPLOAD_DIR=data/uploads

# Email provider — Cloudflare Email Service (preferred) or Postmark. The
# reporter is CC'd on the authority alert. Without a token for either,
# outbox rows stay pending.
# Cloudflare: from-domain must be onboarded to Email Sending in the dashboard
# (adds cf-bounce MX/SPF/DKIM records); needs Workers Paid plan to send to
# arbitrary recipients; token needs the "Email Sending" permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_EMAIL_FROM=leaks@peec.biz

POSTMARK_TOKEN=
POSTMARK_FROM=leaks@example.nz
# SMS gateway for councils on the 'sms' submission channel (#35).
# POST {to, text} JSON + bearer token — works with generic HTTPS SMS APIs.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Optional fallback authority-alert recipient for zones with an empty
# alert_emails list (imported TA boundaries start empty until councils supply
# duty addresses). Empty → no authority alert for those zones.
ALERT_FALLBACK_EMAIL=

# Worker cadence (ms)
OUTBOX_INTERVAL_MS=30000
SLA_SWEEP_MS=300000

# Test-only: disables the in-memory rate limiter. Never set in production.
DISABLE_RATE_LIMIT=

# CORS allowed origins (comma-separated). '*' default suits the public API;
# set to the deployed web origin for tighter posture.
# CORS_ORIGIN=https://leakdetector.up.railway.app
